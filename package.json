{
  "name": "workplace-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "convert": "bash scripts/convert-usdz.sh",
    "strip": "node scripts/strip-glb-image.mjs",
    "shrink": "node scripts/shrink-glb.mjs",
    "shrink:parts": "node scripts/shrink-parts.mjs",
    "shrink:hornet-base": "node scripts/shrink-hornet-base.mjs",
    "shrink:textures": "node scripts/shrink-textures.mjs",
    "textures": "bash scripts/extract-desk-textures.sh",
    "apple": "bash scripts/import-apple-models.sh",
    "split": "bash scripts/split-display-mount.sh",
    "wall": "python3 scripts/extract-wall-texture.py",
    "floor": "bash scripts/copy-floor-tiles.sh"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.2.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
